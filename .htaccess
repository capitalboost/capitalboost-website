Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Force trailing slash on directory URLs
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ %{REQUEST_URI}/ [R=301,L]

# Redirect old blog article paths (folders had spaces)
RewriteRule ^blog/A1(%20|\ )Cat(%20|\ )costa(%20|\ )un(%20|\ )site/?$ /blog/cat-costa-un-website-in-romania-2026/ [R=301,L,NC]
RewriteRule ^blog/A2(%20|\ )website(%20|\ )sau(%20|\ )facebook/?$ /blog/website-sau-pagina-facebook-ce-alegi/ [R=301,L,NC]
RewriteRule ^blog/A3(%20|\ )ai(%20|\ )nevoie(%20|\ )de(%20|\ )un(%20|\ )website/?$ /blog/5-semne-ca-afacerea-ta-are-nevoie-de-website/ [R=301,L,NC]

# Redirect non-existent 4th article
RewriteRule ^blog/ce-este-seo-pentru-afaceri-mici/?$ /blog/ [R=301,L]

# Slug scurtat, raportat de Search Console ca 404. Exista un link extern catre el.
RewriteRule ^blog/website-sau-pagina-facebook/?$ /blog/website-sau-pagina-facebook-ce-alegi/ [R=301,L,NC]

<IfModule mod_headers.c>
  # Headere de securitate. Lipseau toate.
  #
  # HSTS la 180 de zile, nu un an: e singurul header greu de retras, fiindca
  # browserele care l-au vazut refuza HTTP pana expira. Se poate urca dupa ce
  # sta linistit cateva luni.
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # SAMEORIGIN, nu DENY: paginile isi incarca intre ele harti si formulare.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # CSS-ul generat din Tailwind nu are hash in nume, deci un cache lung ar
  # servi stiluri vechi peste HTML nou dupa un deploy. O ora e suficient cat
  # sa ajute la navigare, fara riscul asta. Daca ajungem sa punem hash in
  # nume, se poate urca la un an.
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Scriptul de consimtamant e relevant juridic, deci vizitatorii trebuie sa
  # primeasca mereu versiunea curenta. Fara asta Cloudflare il tine cache-uit
  # pana la 4 ore dupa un deploy, cu textul vechi al bannerului.
  <Files "cookie-consent.js">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </Files>
</IfModule>
